{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "name": "@elelcode/lit-router",
  "version": "1.0.3",
  "license": "MIT",
  "exports": {
    ".": "./src/router.ts"
  },
  "publish": {
    "exclude": [
      ".codex",
      ".github/",
      "dist/",
      "examples/",
      "lib/",
      "node_modules/",
      "public/",
      "tests/",
      "tests/e2e/",
      "index.html",
      "TODO.md"
    ]
  },
  "lock": true,
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "dom",
      "esnext"
    ],
    "noImplicitOverride": false
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.15",
    "happy-dom": "npm:happy-dom@^20.9.0",
    "lit": "npm:lit@^3.3.2",
    "puppeteer": "npm:puppeteer@^24.15.0"
  },
  "tasks": {
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint src tests examples",
    "check": "deno check --sloppy-imports src/router.ts src/router-core.ts src/router-view.ts src/browser-env.ts src/scroll-manager.ts examples/demo/app-root.ts examples/demo/demo-pages.ts examples/minimal/main.ts tests/router_test.ts",
    "build": "deno task fmt:check && deno task lint && deno task check && deno task test",
    "build:package": "deno check --sloppy-imports src/router.ts src/router-core.ts src/router-view.ts src/browser-env.ts src/scroll-manager.ts",
    "build:demo": "deno check --sloppy-imports examples/demo/app-root.ts examples/demo/demo-pages.ts examples/minimal/main.ts",
    "test": "deno test --sloppy-imports -A tests/router_test.ts tests/test_setup.ts",
    "test:e2e": "deno test -A tests/e2e/e2e_test.ts"
  }
}
